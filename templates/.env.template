# ========================================================
# PLANTILLA .env - BACKEND TOTEM LOCAL (BOLETOS.LA CHILE)
# Copiar a: C:\ProgramData\kiosk\backend\.env
# ========================================================

NODE_ENV=production
PORT=3000
TOTEM_ID=101
# AUTO autodetecta la impresora termica fisica de Windows (o colocar nombre exacto, ej: SPRT SC260324  80mm Series)
PRINTER_NAME=AUTO
FORCE_HARDWARE_CONNECTION=true

# Comunicacion CORS desde Netlify / boletos.la
ALLOWED_ORIGINS=*

# POS Transbank USB-Serial (AUTO detecta COM3/COM4/COM5 y canal PAX VID_2FB8 MI_00 automaticamente)
TBK_PORT_PATH=AUTO
TBK_BAUD_RATE=115200
TBK_TIMEOUT=30000
