# ========================================================
# PLANTILLA .env - BACKEND TOTEM LOCAL (BOLETOS.LA CHILE)
# Copiar a: C:\ProgramData\kiosk\backend\.env
# ========================================================

NODE_ENV=production
PORT=3000
TOTEM_ID=101
PRINTER_NAME=w80
FORCE_HARDWARE_CONNECTION=true

# Comunicacion CORS desde Netlify / boletos.la
ALLOWED_ORIGINS=*

# POS Transbank USB-Serial (AUTO detecta COM3/COM4/COM5 automaticamente)
TBK_PORT_PATH=AUTO
TBK_BAUD_RATE=115200
TBK_TIMEOUT=30000
