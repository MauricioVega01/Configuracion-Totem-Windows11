@echo off
title Totem Runtime Boletos.la (ID 101)

:: Fijar impresora predeterminada fisica y evitar que Windows la cambie automaticamente
reg add "HKCU\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Windows" /v LegacyDefaultPrinterMode /t REG_DWORD /d 1 /f >nul 2>&1
set "TARGET_PRINTER=AUTO"
if /I "%TARGET_PRINTER%"=="AUTO" for /f "usebackq delims=" %%p in (`powershell -NoProfile -Command "(Get-Printer | Where-Object { $_.Name -notmatch 'PDF|OneNote|Fax|XPS|Microsoft' } | Select-Object -First 1).Name"`) do set "TARGET_PRINTER=%%p"
if not "%TARGET_PRINTER%"=="" if /I not "%TARGET_PRINTER%"=="AUTO" powershell -NoProfile -Command "(New-Object -ComObject WScript.Network).SetDefaultPrinter('%TARGET_PRINTER%')" >nul 2>&1

:: Limpiar instancias previas para evitar conflictos en puerto 3000 o puerto COM
taskkill /F /IM node.exe >nul 2>&1
taskkill /F /IM chrome.exe >nul 2>&1
timeout /t 1 /nobreak >nul

:: Iniciar backend local en puerto 3000 (minimizado con auto-reinicio)
start /min "POS_BACKEND" cmd /c "C:\ProgramData\kiosk\start-backend.bat"
timeout /t 3 /nobreak >nul

:: Resolver dinamicamente ubicacion de Chrome (System, x86 o perfil local)
set "CHROME_EXE="
if exist "C:\Program Files\Google\Chrome\Application\chrome.exe" set "CHROME_EXE=C:\Program Files\Google\Chrome\Application\chrome.exe"
if exist "C:\Program Files (x86)\Google\Chrome\Application\chrome.exe" set "CHROME_EXE=C:\Program Files (x86)\Google\Chrome\Application\chrome.exe"
if exist "%LocalAppData%\Google\Chrome\Application\chrome.exe" set "CHROME_EXE=%LocalAppData%\Google\Chrome\Application\chrome.exe"
if exist "C:\Users\wit\AppData\Local\Google\Chrome\Application\chrome.exe" set "CHROME_EXE=C:\Users\wit\AppData\Local\Google\Chrome\Application\chrome.exe"
if not defined CHROME_EXE set "CHROME_EXE=chrome.exe"

:: Bucle protegido de Chrome Kiosk (solo relanza si chrome.exe no esta corriendo; evita recargas)
:kiosk_loop
tasklist /FI "IMAGENAME eq chrome.exe" 2>nul | find /I /N "chrome.exe" >nul
if errorlevel 1 start "" "%CHROME_EXE%" --kiosk --kiosk-printing https://totem-testing-v3.netlify.app/ --disable-web-security --user-data-dir="C:\ProgramData\kiosk\chrome_session" --allow-running-insecure-content --disable-features=BlockInsecurePrivateNetworkRequests,LocalNetworkAccessChecks,LocalNetworkAccessChecksWebSockets --unsafely-treat-insecure-origin-as-secure=http://localhost:3000 --no-first-run --no-default-browser-check --disable-session-crashed-bubble --overscroll-history-navigation=0 --disable-pinch
timeout /t 5 /nobreak >nul
goto kiosk_loop
